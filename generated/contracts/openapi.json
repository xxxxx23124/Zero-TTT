        "additionalProperties": false,
        "properties": {
          "lease_seconds": {
            "default": 60,
            "maximum": 3600.0,
            "minimum": 10.0,
            "title": "Lease Seconds",
            "type": "integer"
          },
          "lease_token": {
            "title": "Lease Token",
            "type": "string"
          },
          "worker_id": {
            "title": "Worker Id",
            "type": "string"
          }
        },
        "required": [
          "worker_id",
          "lease_token"
        ],
        "title": "HeartbeatRequest",
        "type": "object"
      },
      "LeaseJobRequest": {
        "additionalProperties": false,
        "properties": {
          "capability": {
            "$ref": "#/components/schemas/WorkerCapability"
          },
          "lease_seconds": {
            "default": 60,
            "maximum": 3600.0,
            "minimum": 10.0,
            "title": "Lease Seconds",
            "type": "integer"
          },
          "wait_seconds": {
            "default": 20,
            "maximum": 30.0,
            "minimum": 0.0,
            "title": "Wait Seconds",
            "type": "integer"
          },
          "worker_id": {
            "title": "Worker Id",
            "type": "string"
          }
        },
        "required": [
          "worker_id",
          "capability"
        ],
        "title": "LeaseJobRequest",
        "type": "object"
      },
      "SubmitWorkflowRequest": {
        "additionalProperties": false,
        "properties": {
          "idempotency_key": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Idempotency Key"
          },
          "parameters": {
            "additionalProperties": true,
            "title": "Parameters",
            "type": "object"
          },
          "run_id": {
            "default": "",
            "title": "Run Id",
            "type": "string"
          }
        },
        "title": "SubmitWorkflowRequest",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "WorkerCapability": {
        "enum": [
          "data",
          "trainer",
          "selfplay"
        ],
        "title": "WorkerCapability",
        "type": "string"
      },
      "WorkerRegistration": {
        "additionalProperties": false,
        "properties": {
          "capability": {
            "$ref": "#/components/schemas/WorkerCapability"
