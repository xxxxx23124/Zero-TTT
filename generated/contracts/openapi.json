{
  "components": {
    "schemas": {
      "ArtifactKind": {
        "enum": [
          "source-manifest",
          "data-verification",
          "dataset-snapshot",
          "selfplay-bundle",
          "checkpoint",
          "publication",
          "metrics"
        ],
        "title": "ArtifactKind",
        "type": "string"
      },
      "ArtifactRef": {
        "additionalProperties": false,
        "properties": {
          "artifact_id": {
            "title": "Artifact Id",
            "type": "string"
          },
          "format_version": {
            "minimum": 1.0,
            "title": "Format Version",
            "type": "integer"
          },
          "kind": {
            "$ref": "#/components/schemas/ArtifactKind"
          },
          "labels": {
            "additionalProperties": {
              "type": "string"
            },
            "title": "Labels",
            "type": "object"
          },
          "schema_version": {
            "default": 1,
            "title": "Schema Version",
            "type": "integer"
          },
          "sha256": {
            "title": "Sha256",
            "type": "string"
          },
          "size_bytes": {
            "minimum": 0.0,
            "title": "Size Bytes",
            "type": "integer"
          },
          "uri": {
            "title": "Uri",
            "type": "string"
          }
        },
        "required": [
          "kind",
          "artifact_id",
          "format_version",
          "sha256",
          "uri",
          "size_bytes"
        ],
        "title": "ArtifactRef",
        "type": "object"
      },
      "CompleteJobRequest": {
        "additionalProperties": false,
        "properties": {
          "artifacts": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/ArtifactRef"
            },
            "title": "Artifacts",
            "type": "array"
          },
          "lease_token": {
            "title": "Lease Token",
            "type": "string"
          },
          "result": {
            "additionalProperties": true,
            "title": "Result",
            "type": "object"
          },
          "worker_id": {
            "title": "Worker Id",
            "type": "string"
          }
        },
        "required": [
          "worker_id",
          "lease_token"
        ],
        "title": "CompleteJobRequest",
        "type": "object"
      },
      "CreateRunRequest": {
        "additionalProperties": false,
        "properties": {
          "cold_snapshot_id": {
            "title": "Cold Snapshot Id",
            "type": "string"
          },
          "name": {
            "maxLength": 80,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "profile_id": {
            "title": "Profile Id",
            "type": "string"
          }
        },
        "required": [
          "name",
          "profile_id",
          "cold_snapshot_id"
        ],
        "title": "CreateRunRequest",
        "type": "object"
      },
      "DomainEvent": {
        "additionalProperties": false,
        "properties": {
          "event_id": {
            "title": "Event Id",
            "type": "string"
          },
          "job_id": {
            "title": "Job Id",
            "type": "string"
          },
          "kind": {
            "title": "Kind",
            "type": "string"
          },
          "level": {
            "$ref": "#/components/schemas/EventLevel",
            "default": "info"
          },
          "occurred_ns": {
            "exclusiveMinimum": 0.0,
            "title": "Occurred Ns",
            "type": "integer"
          },
          "payload": {
            "additionalProperties": true,
            "title": "Payload",
            "type": "object"
          },
          "schema_version": {
            "default": 1,
            "title": "Schema Version",
            "type": "integer"
          }
        },
        "required": [
          "job_id",
          "kind"
        ],
        "title": "DomainEvent",
        "type": "object"
      },
      "EventLevel": {
        "enum": [
          "info",
          "warning",
          "error"
        ],
        "title": "EventLevel",
        "type": "string"
      },
      "FailJobRequest": {
        "additionalProperties": false,
        "properties": {
          "error_type": {
            "title": "Error Type",
            "type": "string"
          },
          "lease_token": {
            "title": "Lease Token",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "retryable": {
            "default": true,
            "title": "Retryable",
            "type": "boolean"
          },
          "worker_id": {
            "title": "Worker Id",
            "type": "string"
          }
        },
        "required": [
          "worker_id",
          "lease_token",
          "error_type",
          "message"
        ],
        "title": "FailJobRequest",
        "type": "object"
      },
