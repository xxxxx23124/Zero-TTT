{
  "$defs": {
    "ArtifactKind": {
      "enum": [
        "source-manifest",
        "data-verification",
        "dataset-snapshot",
        "selfplay-bundle",
        "checkpoint",
        "publication",
        "metrics"
      ],
      "title": "ArtifactKind",
      "type": "string"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "title": "Artifact Id",
          "type": "string"
        },
        "format_version": {
          "minimum": 1,
          "title": "Format Version",
          "type": "integer"
        },
        "kind": {
          "$ref": "#/$defs/ArtifactKind"
        },
        "labels": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Labels",
          "type": "object"
        },
        "schema_version": {
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        },
        "uri": {
          "title": "Uri",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "artifact_id",
        "format_version",
        "sha256",
        "uri",
        "size_bytes"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "ResourceClass": {
      "enum": [
        "none",
        "data-writer",
        "gpu-exclusive"
      ],
      "title": "ResourceClass",
      "type": "string"
    },
    "WorkerCapability": {
      "enum": [
        "data",
        "trainer",
        "selfplay"
      ],
      "title": "WorkerCapability",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "attempt": {
      "minimum": 1,
      "title": "Attempt",
      "type": "integer"
    },
    "capability": {
      "$ref": "#/$defs/WorkerCapability"
    },
    "idempotency_key": {
      "title": "Idempotency Key",
      "type": "string"
    },
    "inputs": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ArtifactRef"
      },
      "title": "Inputs",
      "type": "array"
    },
    "job_id": {
      "title": "Job Id",
      "type": "string"
    },
    "kind": {
      "title": "Kind",
      "type": "string"
    },
    "lease_expires_ns": {
      "exclusiveMinimum": 0,
      "title": "Lease Expires Ns",
      "type": "integer"
    },
    "lease_token": {
      "title": "Lease Token",
      "type": "string"
    },
    "payload": {
      "additionalProperties": true,
      "title": "Payload",
      "type": "object"
    },
    "resource_class": {
      "$ref": "#/$defs/ResourceClass"
    },
    "run_id": {
      "default": "",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "workflow_id": {
      "title": "Workflow Id",
      "type": "string"
    }
  },
  "required": [
    "job_id",
    "workflow_id",
    "kind",
    "capability",
    "resource_class",
    "attempt",
    "lease_token",
    "lease_expires_ns",
    "idempotency_key",
    "payload"
  ],
  "title": "JobEnvelope",
  "type": "object"
}
