{
  "$defs": {
    "ArtifactKind": {
      "enum": [
        "source-manifest",
        "data-verification",
        "dataset-snapshot",
        "selfplay-bundle",
        "checkpoint",
        "publication",
        "metrics"
      ],
      "title": "ArtifactKind",
      "type": "string"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "title": "Artifact Id",
          "type": "string"
        },
        "format_version": {
          "minimum": 1,
          "title": "Format Version",
          "type": "integer"
        },
        "kind": {
          "$ref": "#/$defs/ArtifactKind"
        },
        "labels": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Labels",
          "type": "object"
        },
        "schema_version": {
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        },
        "uri": {
          "title": "Uri",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "artifact_id",
        "format_version",
        "sha256",
        "uri",
        "size_bytes"
      ],
      "title": "ArtifactRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "cold_snapshot": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "created_ns": {
      "exclusiveMinimum": 0,
      "title": "Created Ns",
      "type": "integer"
    },
    "name": {
      "maxLength": 80,
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "profile": {
      "additionalProperties": true,
      "title": "Profile",
      "type": "object"
    },
    "profile_id": {
      "title": "Profile Id",
      "type": "string"
    },
    "profile_sha256": {
      "title": "Profile Sha256",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "run_id",
    "name",
    "profile_id",
    "profile_sha256",
    "profile",
    "cold_snapshot"
  ],
  "title": "RunSpec",
  "type": "object"
}
